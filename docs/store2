#!/bin/bash
# Read-only profile-preferences shape report for a mounted macOS Data volume.
# Values from the plist are never printed.
set -u
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

plistbuddy_xml() { /usr/libexec/PlistBuddy -x -c Print "$1" 2>/dev/null; }
plutil_xml() { /usr/bin/plutil -convert xml1 -o - "$1" 2>/dev/null; }

inspect_store() {
    local volume=$1 prefs xml compact body root rest key count=0 hash_type=absent payload source
    prefs="$volume/private/var/db/ConfigurationProfiles/Store/MDM_ComputerPrefs.plist"
    [ -f "$prefs" ] && [ ! -L "$prefs" ] || {
        printf 'Volume: %s\nMDM_ComputerPrefs.plist: absent or not a regular file\n' "$volume"
        return 1
    }
    printf 'Volume: %s\n' "$volume"
    source='PlistBuddy XML'
    xml=$(plistbuddy_xml "$prefs") || xml=''
    case "$xml" in
        *'<plist'*) ;;
        *)
            source='plutil XML'
            xml=$(plutil_xml "$prefs") || xml=''
            case "$xml" in
                *'<plist'*) ;;
                *)
                    printf 'XML serialization: unavailable; key count and type UNKNOWN\n'
                    return 1 ;;
            esac ;;
    esac
    printf 'XML source: %s\n' "$source"
    compact=${xml//[[:space:]]/}
    body=${compact#*'<plist'}
    body=${body#*'>'}
    case "$body" in
        '<dict/>'*) root='empty dictionary' ;;
        '<dict>'*) root='dictionary' ;;
        '<array/>'*) root='empty array' ;;
        '<array>'*) root='array' ;;
        '<data/>'*|'<data>'*) root='data' ;;
        '<string/>'*|'<string>'*) root='string' ;;
        '<integer>'*) root='integer' ;;
        '<true/>'*|'<false/>'*) root='boolean' ;;
        *) root='unrecognized' ;;
    esac
    printf 'Top-level type: %s\n' "$root"
    case "$compact" in
        *'<plistversion="1.0"><dict>'*'</dict></plist>') printf 'Expected plist/dictionary wrapper: yes\n' ;;
        *) printf 'Expected plist/dictionary wrapper: no\n' ;;
    esac
    rest=$xml
    while [[ $rest == *'<key>'* ]]; do
        rest=${rest#*'<key>'}
        key=${rest%%'</key>'*}
        count=$((count + 1))
        [ "$key" = MDMServerHash ] || printf 'Other key name: %s\n' "$key"
        rest=${rest#*'</key>'}
    done
    printf 'Key count: %s\n' "$count"
    case "$compact" in
        *'<key>MDMServerHash</key><data>'*) hash_type=data ;;
        *'<key>MDMServerHash</key><string>'*) hash_type=string ;;
        *'<key>MDMServerHash</key>'*) hash_type=other ;;
    esac
    printf 'MDMServerHash type: %s\n' "$hash_type"
    if [ "$hash_type" = data ]; then
        payload=${compact#*'<key>MDMServerHash</key><data>'}
        payload=${payload%%'</data>'*}
        if [ -n "$payload" ]; then
            printf 'MDMServerHash data: nonempty\n'
        else
            printf 'MDMServerHash data: empty\n'
        fi
    fi
}

main() {
    local prefs found=false
    if [ "$#" -eq 1 ]; then
        inspect_store "$1"
    elif [ "$#" -eq 0 ]; then
        for prefs in /Volumes/*/private/var/db/ConfigurationProfiles/Store/MDM_ComputerPrefs.plist; do
            [ -e "$prefs" ] || continue
            found=true
            inspect_store "${prefs%/private/var/db/ConfigurationProfiles/Store/MDM_ComputerPrefs.plist}" || true
        done
        [ "$found" = true ] || { printf 'No mounted profile-preferences file found.\n'; return 1; }
    else
        printf 'Usage: bash store [mounted Data-volume path]\n' >&2
        return 2
    fi
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
